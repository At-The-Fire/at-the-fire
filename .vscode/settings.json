{
    "files.autoSave": "off",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSaveTimeout": 5000,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "never",
        "source.fixAll.eslint": "never"
    },
    "eslint.format.enable": false,
    "eslint.run": "onType",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "peacock.color": "411add",
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#6341e9",
        "activityBar.background": "#6341e9",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#eb7254",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#6341e9",
        "statusBar.background": "#411add",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#6341e9",
        "statusBarItem.remoteBackground": "#411add",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#411add",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#411add99",
        "titleBar.inactiveForeground": "#e7e7e799"
    }
}
